# Project Settings
PROJECT_NAME=ComplyAIgent
ENVIRONMENT=development
LOG_LEVEL=DEBUG

# Database Configuration
# For local dev: sqlite:///./test.db
# For docker: postgresql+asyncpg://comply:complyaigent2026 # pragma: allowlist secret@postgres:5432/complyaigent
DATABASE_URL=sqlite:///./test.db

# Supabase Configuration
SUPABASE_URL=http://localhost:54321
SUPABASE_KEY=dev-key-placeholder


# External LLM Providers (Groq, etc.)
LLM_API_KEY=your_LLM_API_KEY_here
LLM_ENDPOINT=https://api.groq.com/openai/v1
CHAT_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# Embeddings (Cohere, etc.)
COHERE_API_KEY=your_cohere_api_key_here
EMBEDDING_MODEL=embed-multilingual-v3.0

# Vector DB (Optional Milvus)
MILVUS_URI=http://localhost:19530
MILVUS_TOKEN=root:Milvus

# Rate Limiting
POST_RATE_LIMIT=5/30 seconds
GET_RATE_LIMIT=30/minute

# Pipeline
MAX_RETRIES=3
