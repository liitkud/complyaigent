# FerretOPS local/test configuration
# Copy this file to .env and fill in values locally. Never commit .env.

# Project settings
ENVIRONMENT=development
LOG_LEVEL=DEBUG

# Database configuration
# Use SQLite for local tests, or any provider-compatible PostgreSQL URL.
# Neon and other PostgreSQL providers use this same variable.
# The current SQLModel engine is synchronous.
# Example: postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require # pragma: allowlist secret
DATABASE_URL=sqlite:///./test.db

# Frontend/API configuration
# Optional when the frontend and API share an origin. Local development falls
# back to http://localhost:8000; hosted deployments should use a same-origin
# /api proxy instead of requiring a manually copied URL.
# NEXT_PUBLIC_API_URL=http://localhost:8000

# External OpenAI-compatible LLM providers (optional for deterministic tests)
# Use one provider for a live test. The backend provider-selection wiring is
# tracked separately; these names are the canonical credential names.
GROQ_API_KEY=your_groq_api_key_here
CEREBRAS_API_KEY=your_cerebras_api_key_here
LLM_API_KEY=your_LLM_API_KEY_here
LLM_ENDPOINT=https://api.groq.com/openai/v1
CHAT_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# Embeddings provider (optional)
COHERE_API_KEY=your_cohere_api_key_here
EMBEDDING_MODEL=embed-multilingual-v3.0

# Vector database (optional)
MILVUS_URI=http://localhost:19530
MILVUS_TOKEN=your_milvus_token_here

# Rate limiting
POST_RATE_LIMIT=5/30 seconds
GET_RATE_LIMIT=30/minute

# Pipeline
MAX_RETRIES=3

# CLI configuration (the Go CLI does not automatically load this file)
# PG_BACKEND=http://localhost:8000
# PG_MODE=local
# XDG_CONFIG_HOME=$HOME/.config

# Local tooling credentials (never commit .env)
# These are not application runtime settings.
# NEON_API_KEY=your_neon_api_key_here
# CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here
# CLOUDFLARE_ACCOUNT_ID=your_account_id_here
# CLOUDFLARE_ACCOUNT_NAME=your_approved_account_name_here
