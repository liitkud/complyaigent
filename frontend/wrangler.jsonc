{
  "$schema": "https://unpkg.com/wrangler@4.124.0/config-schema.json",
  "name": "ferretops-frontend",
  "main": ".open-next/worker.js",
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
